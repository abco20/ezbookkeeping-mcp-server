EZBK_BASE_URL=http://ezbookkeeping:8080
EZBK_API_TOKEN=replace-with-api-token
EZBK_TIMEZONE=Asia/Tokyo
EZBK_REQUEST_TIMEOUT_MS=10000

# stdio or http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Comma-separated Host header allowlist. Required for custom domains when binding non-loopback.
MCP_HTTP_ALLOWED_HOSTS=
# Optional static bearer token for /mcp. Generate with: openssl rand -hex 32
MCP_HTTP_BEARER_TOKEN=
# Set true only when authentication is enforced by a reverse proxy or the port is loopback-only.
MCP_HTTP_ALLOW_UNAUTHENTICATED=false

# read, standard, extended, admin
MCP_WRITE_PROFILE=read
# Required for standard/extended/admin. Generate with: openssl rand -hex 32
MCP_CONFIRMATION_SECRET=
MCP_CONFIRMATION_TTL_SECONDS=600
MCP_BATCH_UPDATE_LIMIT=100
MCP_AUDIT_LOG_PATH=./data/audit.jsonl
