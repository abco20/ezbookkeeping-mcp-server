{
  "name": "ezbookkeeping-mcp-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Production-oriented independent MCP server for ezBookkeeping HTTP API",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "ezbookkeeping-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage test/*.test.ts",
    "ci": "npm run verify:sdk && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "test:real": "tsx scripts/real-smoke.ts",
    "verify:sdk": "node -e \"Promise.all([import('@modelcontextprotocol/sdk/client/index.js'),import('@modelcontextprotocol/sdk/server/mcp.js'),import('zod')]).catch((error)=>{console.error(error);process.exit(1)})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
